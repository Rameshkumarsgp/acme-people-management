# For local development only. Hosted environments should inject secrets from a secrets vault.
# Copy this file to .env (ignored by git) and fill in both values. Never commit .env.
# The password is blank on purpose: the app refuses to start until you set one, so a copied
# file can never run with a password that anyone could read from the repository.
# Local run:  set -a; . ./.env; set +a; cd backend && ./gradlew bootRun
ACME_AUTH_USERNAME=hr
ACME_AUTH_PASSWORD=

# Database. Used by docker compose and by the API, so there is one set of values.
# The password is blank on purpose: compose and the API both refuse to start without one.
ACME_DB_NAME=acme
ACME_DB_USER=acme
ACME_DB_PASSWORD=
ACME_DB_PORT=5432

# To run the API itself from IntelliJ or a terminal, set these to the same values:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/acme
#   SPRING_DATASOURCE_USERNAME=acme
#   SPRING_DATASOURCE_PASSWORD=<the ACME_DB_PASSWORD above>
# Without them the API refuses to start, with Spring's own "url attribute is not specified" message.
