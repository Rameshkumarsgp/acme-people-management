<FindBugsFilter>
    <!-- Spring Boot entry point and config classes are not designed for extension or immutability -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~com\.acme\.peoplemanagement\..*(Dto|Properties)"/>
    </Match>
    <!-- A test helper that keeps the JdbcTemplate it was given, as any service keeps its collaborators -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="com.acme.peoplemanagement.support.TestEmployees"/>
    </Match>
</FindBugsFilter>
